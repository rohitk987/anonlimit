{
  "name": "anonlimit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-preserving bounded-use credential simulation",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "setup:env": "tsx scripts/setup-local-env.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "build": "pnpm build:packages && pnpm --filter \"./apps/*\" --recursive --sort --workspace-concurrency=1 run build",
    "build:packages": "pnpm --filter \"./packages/*\" --recursive --sort --workspace-concurrency=1 run build",
    "typecheck": "pnpm build:packages && pnpm --recursive --sort --workspace-concurrency=1 run typecheck && tsc -p tsconfig.tooling.json",
    "dev": "docker compose up --build",
    "dev:apps": "pnpm build:packages && pnpm --parallel --filter \"./apps/*\" run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:privacy": "vitest run --project privacy",
    "test:e2e": "playwright test",
    "check:foundation": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:privacy"
  },
  "devDependencies": {
    "@anonlimit/config": "workspace:*",
    "@anonlimit/contracts": "workspace:*",
    "@anonlimit/db": "workspace:*",
    "@anonlimit/observability": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
