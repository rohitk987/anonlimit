# Local placeholders only. Prefer pnpm setup:env to generate ignored .env values.
NODE_ENV=development
DEMO_MODE=true
API_PORT=4000
ACTION_PORT=4100
WEB_ORIGIN=http://localhost:5173
POSTGRES_DB=anonlimit
POSTGRES_USER=migration_owner
POSTGRES_PASSWORD=replace-with-random-owner-password
API_DB_PASSWORD=replace-with-random-api-password
WORKER_DB_PASSWORD=replace-with-random-worker-password
ACTION_DB_PASSWORD=replace-with-random-action-password
DATABASE_URL_MIGRATION=postgresql://migration_owner:replace-with-random-owner-password@postgres:5432/anonlimit
DATABASE_URL_API=postgresql://verifier_api:replace-with-random-api-password@postgres:5432/anonlimit
DATABASE_URL_WORKER=postgresql://verifier_worker:replace-with-random-worker-password@postgres:5432/anonlimit
DATABASE_URL_ACTION=postgresql://action_service:replace-with-random-action-password@postgres:5432/anonlimit
VERIFIER_LEDGER_HMAC_KEY=replace-with-at-least-32-random-characters
VERIFIER_ACTION_HMAC_KEY=replace-with-at-least-32-random-characters
ACTION_SERVICE_URL=http://action-simulator:4100
ACTION_SERVICE_TOKEN=replace-with-at-least-32-random-characters
OPAQUE_CRYPTO_PROVIDER=simulated
OUTBOX_POLL_MS=1000
LOG_LEVEL=info
VITE_API_BASE_URL=http://localhost:4000
VITE_DEMO_MODE=true
